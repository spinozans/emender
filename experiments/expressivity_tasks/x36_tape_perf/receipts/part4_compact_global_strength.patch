+def slot_sum(x, Scratch, FullLive, BS:tl.constexpr, FullBS:tl.constexpr, Tail=0.):
+    # Reconstruct only the reduction operand, not the resident adjoint state.
+    # The byte occupancy operand and scratch alignment retain the historical
+    # blocked reduction layout. Gather-only padding changes floating order.
+    if BS<FullBS:
+        tl.store(Scratch+tl.arange(0,BS),x)
+        tl.debug_barrier()
+        lane=tl.arange(0,FullBS)
+        expanded=tl.load(Scratch+lane,lane<BS,0.,volatile=True)
+        return tl.sum(tl.where((lane<BS)|(~FullLive),tl.where(lane<BS,expanded,Tail),0.),0)
+    return tl.sum(x,0)
+
+
+@triton.jit
+def slot_max(x, Scratch, FullLive, BS:tl.constexpr, FullBS:tl.constexpr):
+    if BS<FullBS:
+        tl.store(Scratch+tl.arange(0,BS),x)
+        tl.debug_barrier()
+        lane=tl.arange(0,FullBS)
+        expanded=tl.load(Scratch+lane,lane<BS,-1.e30,volatile=True)
+        return tl.max(tl.where((lane<BS)|(~FullLive),tl.where(lane<BS,expanded,-1.e30),-1.e30),0)
+    return tl.max(x,0)
+
