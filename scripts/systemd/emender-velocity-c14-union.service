[Unit]
Description=X43 C14 frozen union feature extraction (CPU only)
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/erikg/emender
ExecStart=/home/erikg/emender/.venv/bin/python -m experiments.expressivity_tasks.x43_fork_resolved.c14_union_service
Environment=CUDA_VISIBLE_DEVICES=
Environment=PYTHONUNBUFFERED=1
Restart=on-abnormal
RestartSec=15
KillMode=control-group
TimeoutStopSec=90
UMask=0077
StandardOutput=append:/home/erikg/c14_consultation_features/union_console.jsonl
StandardError=append:/home/erikg/c14_consultation_features/union_stderr.txt

[Install]
WantedBy=default.target
